{
  "name": "algebra-cc-academy",
  "productName": "Algebra C&C Learning Academy",
  "version": "0.4.0",
  "description": "Offline Windows learning app for Georgia Algebra: Concepts & Connections",
  "author": "Adam Harris",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:math": "vitest run tests/math",
    "test:e2e": "node scripts/build-main.mjs && vite build && playwright test",
    "harness": "node scripts/build-main.mjs && vite build && node dist/harness/server.js",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.harris.algebracc.academy",
    "productName": "Algebra C&C Learning Academy",
    "copyright": "Copyright © 2026 Adam Harris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**",
      "dist/renderer/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AlgebraCC-Academy-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Algebra C&C Academy",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
